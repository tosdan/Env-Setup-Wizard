# Variables before the first @section belong to the implicit Configuration group.
TIMEZONE=UTC

# @section Database
# @prompt Database host
# @required
DB_HOST=localhost

# @section Cache
# @prompt Cache host
# @required
CACHE_HOST=localhost

# Reopening Database merges this question into the earlier Database wizard page.
# @section Database
# @prompt Database name
# @required
DB_NAME=demo_app

# Reopening the implicit group also merges with Configuration in the wizard.
# @section Configuration
# @prompt Log output format
# @options plain,json
LOG_FORMAT=plain

# Output order still follows this file rather than the merged wizard page order.
