# Fictional web application settings
# Normal comments are preserved in the generated file.

# @section Application
# @prompt Application display name
# @description Shown in local pages and development logs
# @required
# @placeholder acme-api
APP_NAME=demo-api

# @prompt Deployment environment
# @description Select one of the environments accepted by this example application
# @options development,staging,production
APP_ENV=development

# @prompt Optional welcome banner
# @description Leave empty to use the application's built-in message
# @placeholder Welcome to the demo
WELCOME_BANNER=
