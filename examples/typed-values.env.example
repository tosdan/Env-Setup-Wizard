# Fields with each supported @type value

# @section Runtime
# @prompt Deployment region
# @description An explicit string field; no external region lookup is performed
# @type string
# @required
REGION=eu-west-1

# @prompt Worker processes
# @description Signed decimal integer stored exactly as entered
# @type int
# @required
WORKER_COUNT=4

# @prompt Enable debug output
# @description Boolean answers are rendered as lowercase true or false
# @type bool
DEBUG=false

# @prompt HTTP listening port
# @description Decimal port in the range 1 through 65535
# @type port
# @required
HTTP_PORT=8080

# @section Endpoints
# @prompt Public application URL
# @description Must be an absolute URI; the wizard does not contact it
# @type url
# @required
# @placeholder https://app.example.test
PUBLIC_URL=http://localhost:8080

# @prompt Optional telemetry collector
# @description Empty is allowed because this field is not marked required
# @type url
# @placeholder https://telemetry.example.test/v1/traces
OTEL_EXPORTER_ENDPOINT=
