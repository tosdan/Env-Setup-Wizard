# Secret presentation and template-owned values

# @section Database
# @prompt Database username
# @description Used only by this fictional local database
# @required
DB_USERNAME=demo_user

# @prompt Database password
# @description Stored in plaintext in the generated file and its backups
# @secret
# @required
DB_PASSWORD='change-me-locally'

# @section External service
# @prompt Optional API token
# @description Input is masked; summaries show only whether a value is set
# @secret
EXTERNAL_API_TOKEN=

# @section Template managed
# @description This value always comes from the template and is not asked in the wizard
# @fixed
# @required
COMPOSE_PROJECT_NAME=env-wizard-demo

# @description Another fixed value, included to show that fixed fields still appear in the summary
# @fixed
CONFIG_FORMAT_VERSION=1
